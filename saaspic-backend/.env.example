# Local development only; production values belong in hosting environment settings.
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/saaspin_dev
JWT_SECRET=
# Generate a random JWT secret before starting. Production requires >=32 characters.
TRUST_PROXY=0
# Production SMTP is mandatory for account recovery/invitations; never use dev fallback there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional AI feature; core API starts without it and generation returns 503.
GEMINI_API_KEY=
# One-time bootstrap script only, never exposed to the frontend.
ADMIN_EMAIL=
ADMIN_PASSWORD=
